# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development                      # development | staging | production
APP_URL=http://localhost:3000
APP_NAME="گیفتی‌پی"

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/giftipay?schema=public"

# ── Secrets (generate with: openssl rand -base64 48) ──────────
# Session JWT signing key. MUST be >= 32 chars. Rotate on compromise.
AUTH_SECRET=""
# AES-256-GCM master key for encrypting gift-card codes at rest.
# MUST be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# WARNING: losing this key makes every stored code unrecoverable.
ENCRYPTION_KEY=""
# HMAC key used to fingerprint codes for duplicate detection (never reversible).
CODE_FINGERPRINT_KEY=""

# ── Payment: ZarinPal ─────────────────────────────────────────
ZARINPAL_MERCHANT_ID=""
ZARINPAL_MODE=sandbox                    # sandbox | production
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payments/zarinpal/callback

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="گیفتی‌پی <no-reply@example.com>"

# ── SMS (Iranian provider, e.g. Kavenegar) ────────────────────
SMS_PROVIDER=log                         # log | kavenegar
SMS_API_KEY=""
SMS_SENDER=""

# ── Security / limits ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_TTL_HOURS=168
CART_RESERVATION_MINUTES=15
PRICE_QUOTE_TTL_MINUTES=30
PRICE_STALE_BLOCK_HOURS=24
PRICE_APPROVAL_THRESHOLD_PERCENT=15

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=""
HEALTHCHECK_TOKEN=""

# ── Seed ──────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@giftipay.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
